# alf.io image for the benchmark, parameterized.
# Build context: the extracted alf.io application (alfio-boot.jar + lib/), see scripts/build-images.sh
#
# STARTUP: how the startup is optimized
#   appcds: dynamic AppCDS archive (what alf.io ships on JDK 25, with the archive generated by the right runtime)
#   aot:    Leyden AOT cache, trained at startup
#   none:   only the base CDS archive of the runtime
# JVM_OPTS: options that the archive/cache depends on (GC, compact object headers), used both for training and at runtime
# TRAIN_OPTS: the training JVM gets the same heap and CPU count as the container it will run in
ARG JDK_IMAGE=eclipse-temurin:27-alpine

FROM ${JDK_IMAGE} AS jdk
ARG STARTUP=aot
ARG JVM_OPTS=""
ARG TRAIN_OPTS="-Xmx256m -XX:ActiveProcessorCount=2"
# jdk.jfr: Flight Recorder for the diagnostic runs; jdk.jcmd: forces a full GC at the end of a run, to measure the live data
RUN "$JAVA_HOME/bin/jlink" --compress=zip-6 --strip-java-debug-attributes --no-header-files --no-man-pages \
    --module-path "$JAVA_HOME/jmods" \
    --add-modules java.desktop,java.logging,java.sql,java.management,java.naming,jdk.unsupported,jdk.crypto.ec,java.net.http,jdk.localedata,java.instrument,jdk.jfr,jdk.jcmd \
    --include-locales en,it,es,nl,fr,de,ro,pt,tr,pl,da,bg,sv,cs \
    --output /jlinked
# the base CDS archive must match the runtime: options that change the object layout (e.g. compact object headers), and modules
RUN /jlinked/bin/java -Xshare:dump --add-modules jdk.jfr $JVM_OPTS -version
COPY alfio-boot.jar /cds/
COPY lib /cds/lib
WORKDIR /cds
RUN case "$STARTUP" in \
      appcds) /jlinked/bin/java $JVM_OPTS $TRAIN_OPTS --add-modules jdk.jfr -XX:ArchiveClassesAtExit=alfio.jsa \
                -Dspring.profiles.active=app-cds -Dspring.context.exit=onRefresh -jar alfio-boot.jar ;; \
      aot) /jlinked/bin/java $JVM_OPTS $TRAIN_OPTS --add-modules jdk.jfr -XX:AOTCacheOutput=alfio.aot \
                -Dspring.profiles.active=app-cds -Dspring.context.exit=onRefresh -jar alfio-boot.jar ;; \
      none) ;; \
      *) echo "unknown STARTUP: $STARTUP" && exit 1 ;; \
    esac


FROM alpine:3.24
ARG STARTUP=aot
ARG JVM_OPTS=""

ENV LANG=en_US.UTF-8
ENV ALFIO_JAVA_OPTS=""
ENV ALFIO_PERFORMANCE_OPTS="-Dspring.jmx.enabled=false -Dlog4j2.disableJmx=true"
ENV ALFIO_JVM_OPTS="${JVM_OPTS}"
ENV ALFIO_STARTUP="${STARTUP}"

RUN addgroup -S alfio \
    && adduser -h /home/alfio -u 1001 -G alfio -S alfio \
    && apk add --no-cache ttf-dejavu \
    && mkdir /home/alfio/app

COPY --from=jdk /jlinked /opt/jdk/
COPY --chown=alfio --from=jdk /cds/ /home/alfio/app/
COPY --chmod=755 start.sh /home/alfio/start.sh

USER 1001
WORKDIR /home/alfio/app
CMD ["/home/alfio/start.sh"]
EXPOSE 8080
